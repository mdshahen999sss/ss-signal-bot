function generateStrategySignal(ind) {
    if (!ind) {
        return {
            signal: 'WAIT',
            scoreCategory: 'WAIT',
            confidence: 50,
            reasons: ['Insufficient historical candle data']
        };
    }

    let bullScore = 0;
    let bearScore = 0;
    let reasons = [];

    // 1. Price Action Score (Max 35)
    if (ind.priceAction.includes("Bullish")) {
        bullScore += 35;
        reasons.push("Price Action: Bullish Rejection/Body");
    } else if (ind.priceAction.includes("Bearish")) {
        bearScore += 35;
        reasons.push("Price Action: Bearish Rejection/Body");
    }

    // 2. EMA Trend Score (Max 25)
    if (ind.ema9 > ind.ema21) {
        bullScore += 25;
        reasons.push("EMA: Uptrend (EMA 9 > 21)");
    } else if (ind.ema9 < ind.ema21) {
        bearScore += 25;
        reasons.push("EMA: Downtrend (EMA 9 < 21)");
    }

    // 3. RSI Score (Max 20)
    if (parseFloat(ind.rsi) >= 50) {
        bullScore += 20;
        reasons.push(`RSI (${ind.rsi}): Bullish Zone`);
    } else {
        bearScore += 20;
        reasons.push(`RSI (${ind.rsi}): Bearish Zone`);
    }

    // 4. MACD Score (Max 20)
    if (parseFloat(ind.macdHist) >= 0) {
        bullScore += 20;
        reasons.push("MACD: Positive Zone");
    } else {
        bearScore += 20;
        reasons.push("MACD: Negative Zone");
    }

    // Decision Logic with Lower Threshold for Responsive Signals
    let finalSignal = 'WAIT';
    let totalScore = 50;

    if (bullScore > bearScore) {
        finalSignal = 'UP';
        totalScore = 60 + Math.min((bullScore - bearScore), 35);
    } else if (bearScore > bullScore) {
        finalSignal = 'DOWN';
        totalScore = 60 + Math.min((bearScore - bullScore), 35);
    }

    // Score Categories
    let scoreCategory = 'MODERATE';
    if (totalScore >= 80) scoreCategory = 'STRONG';
    else if (totalScore >= 70) scoreCategory = 'GOOD';
    else if (totalScore >= 60) scoreCategory = 'MODERATE';

    return {
        signal: finalSignal,
        scoreCategory: scoreCategory,
        confidence: Math.round(totalScore),
        reasons: reasons
    };
}

module.exports = { generateStrategySignal };
