const { RSI, EMA, MACD } = require('technicalindicators');

function calculateIndicators(candles) {
    if (!Array.isArray(candles) || candles.length < 30) {
        return null;
    }

    const closePrices = candles.map(c => Number(c.close));
    const current = candles[candles.length - 1];

    // =========================
    // 1. RSI (14)
    // =========================
    const rsiArray = RSI.calculate({
        values: closePrices,
        period: 14
    });

    const rsi = rsiArray.length
        ? Number(rsiArray[rsiArray.length - 1].toFixed(2))
        : 50;

    // =========================
    // 2. EMA 9 & EMA 21
    // =========================
    const ema9Array = EMA.calculate({
        values: closePrices,
        period: 9
    });

    const ema21Array = EMA.calculate({
        values: closePrices,
        period: 21
    });

    const ema9 = ema9Array.length
        ? ema9Array[ema9Array.length - 1]
        : current.close;

    const ema21 = ema21Array.length
        ? ema21Array[ema21Array.length - 1]
        : current.close;

    let emaTrend = 'Neutral';

    if (ema9 > ema21) {
        emaTrend = 'Bullish (EMA 9 > 21)';
    } else if (ema9 < ema21) {
        emaTrend = 'Bearish (EMA 9 < 21)';
    }

    // =========================
    // 3. MACD (12,26,9)
    // =========================
    const macdArray = MACD.calculate({
        values: closePrices,
        fastPeriod: 12,
        slowPeriod: 26,
        signalPeriod: 9,
        SimpleMAOscillator: false,
        SimpleMASignal: false
    });

    let macdHist = 0;
    let macdTrend = 'Neutral';

    if (macdArray.length >= 2) {
        const currentMacd = macdArray[macdArray.length - 1];
        const previousMacd = macdArray[macdArray.length - 2];

        const currentHist = Number(currentMacd.histogram || 0);
        const previousHist = Number(previousMacd.histogram || 0);

        macdHist = Number(currentHist.toFixed(5));

        if (currentHist > 0 && currentHist > previousHist) {
            macdTrend = 'Strong Bullish Momentum';
        } else if (currentHist > 0) {
            macdTrend = 'Weakening Bullish Momentum';
        } else if (currentHist < 0 && currentHist < previousHist) {
            macdTrend = 'Strong Bearish Momentum';
        } else if (currentHist < 0) {
            macdTrend = 'Weakening Bearish Momentum';
        }
    }

    // =========================
    // 4. PRICE ACTION
    // =========================
    const open = Number(current.open);
    const high = Number(current.high);
    const low = Number(current.low);
    const close = Number(current.close);

    const bodySize = Math.abs(close - open);
    const candleRange = high - low;

    const upperWick =
        high - Math.max(open, close);

    const lowerWick =
        Math.min(open, close) - low;

    let priceAction = 'Neutral / Doji';
    let paScore = 0;

    if (candleRange > 0) {

        // Bullish candle
        if (close > open) {

            if (lowerWick > bodySize * 1.5) {
                priceAction = 'Bullish Pinbar Rejection';
                paScore = 70;

            } else if (bodySize > candleRange * 0.6) {
                priceAction = 'Strong Bullish Body';
                paScore = 60;

            } else {
                priceAction = 'Weak Bullish Body';
                paScore = 25;
            }

        // Bearish candle
        } else if (close < open) {

            if (upperWick > bodySize * 1.5) {
                priceAction = 'Bearish Pinbar Rejection';
                paScore = -70;

            } else if (bodySize > candleRange * 0.6) {
                priceAction = 'Strong Bearish Body';
                paScore = -60;

            } else {
                priceAction = 'Weak Bearish Body';
                paScore = -25;
            }

        } else {
            priceAction = 'Doji / Neutral';
            paScore = 0;
        }
    }

    // =========================
    // 5. FRACTAL SUPPORT / RESISTANCE
    // =========================
    let fractal = 'Neutral';

    const len = candles.length;

    if (len >= 5) {

        const c2 = candles[len - 3];

        const leftHigh1 = Number(candles[len - 5].high);
        const leftHigh2 = Number(candles[len - 4].high);
        const rightHigh1 = Number(candles[len - 2].high);
        const rightHigh2 = Number(current.high);

        const leftLow1 = Number(candles[len - 5].low);
        const leftLow2 = Number(candles[len - 4].low);
        const rightLow1 = Number(candles[len - 2].low);
        const rightLow2 = Number(current.low);

        if (
            c2.high > leftHigh1 &&
            c2.high > leftHigh2 &&
            c2.high > rightHigh1 &&
            c2.high > rightHigh2
        ) {
            fractal = 'Bearish Resistance Fractal';

        } else if (
            c2.low < leftLow1 &&
            c2.low < leftLow2 &&
            c2.low < rightLow1 &&
            c2.low < rightLow2
        ) {
            fractal = 'Bullish Support Fractal';
        }
    }

    // =========================
    // 6. CANDLE MOMENTUM
    // =========================
    let volumeText = 'Normal Market';

    if (candleRange > 0) {
        const bodyRatio = bodySize / candleRange;

        if (bodyRatio >= 0.7) {
            volumeText = 'High Momentum';
        } else if (bodyRatio >= 0.4) {
            volumeText = 'Normal Momentum';
        } else {
            volumeText = 'Low Momentum';
        }
    }

    // =========================
    // RETURN
    // =========================
    return {
        rsi,

        ema9: Number(ema9.toFixed(6)),
        ema21: Number(ema21.toFixed(6)),
        emaTrend,

        macdHist,
        macdTrend,

        priceAction,
        paScore,

        fractal,
        volumeText,

        currentCandle: {
            open,
            high,
            low,
            close
        }
    };
}

module.exports = {
    calculateIndicators
};
